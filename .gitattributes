* text=auto eol=lf

# Shell scripts must use LF
*.sh text eol=lf
*.bash text eol=lf

# Python uses LF
*.py text eol=lf

# Config files
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf

# Markdown
*.md text eol=lf

# Windows scripts get CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
